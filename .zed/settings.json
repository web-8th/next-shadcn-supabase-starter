// Project settings for Zed: https://zed.dev/docs/configuring-zed#settings-files
//
// Prettier owns all formatting, including import order
// (via @ianvs/prettier-plugin-sort-imports), so don't add source.organizeImports.
// oxlint fixes run first (needs the Oxc extension), then Prettier formats.
{
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "wrap_guides": [90],
  "languages": {
    "TypeScript": {
      "formatter": "prettier",
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "TSX": {
      "formatter": "prettier",
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "JavaScript": {
      "formatter": "prettier",
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "CSS": { "formatter": "prettier" },
    "JSON": { "formatter": "prettier" },
    "JSONC": { "formatter": "prettier" },
    "Markdown": { "formatter": "prettier" },
    "YAML": { "formatter": "prettier" }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        // Class IntelliSense inside cn() and cva()
        "classFunctions": ["cn", "cva"]
      }
    }
  }
}

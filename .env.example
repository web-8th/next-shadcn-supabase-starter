# Copy to .env.local.
#
# Local: after `pnpm db:start`, this writes all three values into .env.local
# (overwrites the file, so use >> instead of > to append):
#   pnpm exec supabase status -o env --override-name api.url=NEXT_PUBLIC_SUPABASE_URL --override-name auth.publishable_key=NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY --override-name auth.secret_key=SUPABASE_SECRET_KEY | grep -E "^(NEXT_PUBLIC_SUPABASE|SUPABASE_SECRET)" > .env.local
#
# Hosted: Project Settings -> API Keys.

# Public: sent to the browser. Used by the browser client and proxy (respects RLS).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Server-only: bypasses RLS. Used by utils/supabase/admin.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
